# Copy to .env.local for local development. Never commit real values.
# These are server-side only; nothing here is exposed to the browser.

# Canonical public URL, used for metadata, sitemap and canonical links.
# Local default is http://localhost:3000 when unset.
SITE_URL=http://localhost:3000

# Set to "true" to show planned (unbuilt) navigation and unconfigured links in a
# production build. In development they are always shown. Leave unset for public deploys.
SHOW_PLANNED=false

# ---------------------------------------------------------------------------
# Database (Phase 2b: NOT used yet; documented so the shape is fixed early)
# All server-side. Never prefix with NEXT_PUBLIC_. Never commit real values.
# ---------------------------------------------------------------------------
# Runtime, pooled connection as the least-privilege role "app_runtime":
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Migrations only, direct connection as "app_migrator". Set on your machine and in the CI
# migration job, NEVER on the deployed application:
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Where the public site reads content from: files | snapshot
# CONTENT_SOURCE=files
