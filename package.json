{
  "name": "prince-sec",
  "version": "0.1.0",
  "private": true,
  "description": "PrinceSec: the cybersecurity and security-engineering portfolio of Prince Ntunka.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:a11y": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:a11y"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
